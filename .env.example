# Local backend:
# VITE_API_URL=http://127.0.0.1:5000
#
# Production subdomain example:
# VITE_API_URL=https://api.example.uz
VITE_API_URL=http://127.0.0.1:5000
VITE_USE_MOCK_API=false

# Raspberry Pi backend:
GREENHOUSE_HOST=127.0.0.1
GREENHOUSE_PORT=5000
GREENHOUSE_DEBUG=false
USE_GPIO=true
USE_REAL_SENSORS=true
GPIO_ACTIVE_LOW=true
MANUAL_OVERRIDE_SECONDS=120

# Arduino kodidagi qurilmalar Raspberry Pi BCM pinlariga ko'chirildi:
GPIO_DRIP_PIN=17
GPIO_RAIN_PIN=27
GPIO_COOLER_PIN=22
GPIO_LED_PIN=5

# Sensor/signallar:
DHT_PIN=4
IR_PIN=18
LIGHT_DIGITAL_PIN=23
LIGHT_DARK_SIGNAL=1
SOIL_ADC_CHANNEL=0
LIGHT_ADC_CHANNEL=1
SOIL_DRY_VALUE=850
SOIL_WET_VALUE=350
